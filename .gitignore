# Deployment allowlist. Local experiments are retained, never uploaded by default.
/*
!/.gitignore
!/app.py
!/collect_one.py
!/cloud_config.py
!/cloud_readiness.py
!/requirements.txt
!/requirements-dev.txt
!/packages.txt
!/CLOUD_DEPLOYMENT.md
!/CLOUD_READINESS_REPORT.md
!/deployment_manifest.json
!/crawler/
/crawler/*
!/crawler/*.py
!/extractor/
/extractor/*
!/extractor/*.py
!/dataset/
/dataset/*
!/dataset/__init__.py
!/dataset/schema.py
!/dataset/domains.py
!/ui/
/ui/*
!/ui/__init__.py
!/ui/final_app.py
!/ui/final_style.py
!/ui/final_views.py
!/ui/analysis.py
!/ui/inference.py
!/ui/demo.py
!/ui/demo_server.py
!/ui/errors.py
!/ui/tables.py
!/tests/
/tests/*
!/tests/test_cloud_security.py
!/tests/test_cloud_runtime.py
!/tests/test_cloud_browser.py
!/tests/pages/
/tests/pages/*
!/tests/pages/01_static_simple.html
!/robustness/
/robustness/*
!/robustness/originals/
/robustness/originals/*
!/robustness/originals/O01_STATIC_LOGIN.html
!/robustness/variants/
/robustness/variants/*
!/robustness/variants/O01_STATIC_LOGIN_M04_1500.html
!/output/
/output/*
!/output/final_test_evaluation/
/output/final_test_evaluation/*
!/output/final_test_evaluation/primary_model_result.json
!/output/final_test_evaluation/final_test_metrics.csv
!/output/final_test_evaluation/models/
/output/final_test_evaluation/models/*
!/output/final_test_evaluation/models/F02_RF_A08.joblib
!/output/feature_ablation/
/output/feature_ablation/*
!/output/feature_ablation/feature_subsets.json
!/output/feature_ablation/ablation_results.csv
!/output/model_interpretability/
/output/model_interpretability/*
!/output/model_interpretability/group_permutation_importance.csv
!/output/temporal_evaluation/
/output/temporal_evaluation/*
!/output/temporal_evaluation/temporal_metrics.json
!/output/phase11_structural_robustness/
/output/phase11_structural_robustness/*
!/output/phase11_structural_robustness/phase11_summary.json
!/output/phase11_structural_robustness/phase11_model_summary.csv
!/output/phase11_structural_robustness/figures/
/output/phase11_structural_robustness/figures/*
!/output/phase11_structural_robustness/figures/primary_probability_shift.png

# Secrets and caches remain ignored even inside allowed directories.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.env
**/secrets.toml
